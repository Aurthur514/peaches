# Example environment variables for backend
# Toggle OCR backends
ENABLE_TESSERACT=1
ENABLE_EASYOCR=0

# Model path (relative to backend/)
MODEL_PATH=models/model.onnx

# ONNX input mapping example (not used by dotenv directly - edit backend/config.py)
# ONNX_INPUT_MAP input names to feature keys can be set in backend/config.py

# Thresholds
CONFIDENCE_BUY=0.65
CONFIDENCE_SELL=0.35
