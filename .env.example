# Trading Bot Environment Configuration
# Copy this file to .env and fill in your API credentials

# CoinSwitch API Credentials (REQUIRED)
CS_API_KEY=your_coinswitch_api_key_here
CS_API_SECRET_HEX=your_64_char_hex_private_key_here

# Trading Configuration (Optional - has defaults)
CS_WALLET_BALANCE=1000
CS_MAX_SYMBOLS=50
CS_DEFAULT_LEVERAGE=3

# Execution Mode (IMPORTANT!)
CS_DRY_RUN=true
# Set to false for live trading: CS_DRY_RUN=false

# Cloud Logging Configuration
LOG_LEVEL=INFO
ENABLE_CLOUD_LOGGING=true

# Monitoring (Optional)
WEBHOOK_URL=https://your-webhook-url-for-notifications